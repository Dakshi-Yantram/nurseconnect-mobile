{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "http://localhost:8001",
        "EXPO_PUBLIC_SUPPORT_CHAT": "true"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.nurseconnect.co.in",
        "EXPO_PUBLIC_ALLOW_SCREEN_CAPTURE": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "credentialsSource": "remote",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.nurseconnect.co.in",
        "APS_ENVIRONMENT": "production"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "staging-apk": {
      "channel": "staging",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://see-resist-teams-integral.trycloudflare.com",
        "EXPO_PUBLIC_ALLOW_SCREEN_CAPTURE": "true",
        "EXPO_PUBLIC_SUPPORT_CHAT": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}